# https://editorconfig.org — keeps editors on Windows, macOS and Linux consistent
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# two trailing spaces are a Markdown line break
trim_trailing_whitespace = false

[*.{cmd,bat,ps1}]
end_of_line = crlf
