# Normalise line endings: text files are stored with LF and checked out with LF on every OS,
# so Windows clones behave like macOS/Linux ones (Node, Vite and the tests do not need CRLF).
* text=auto eol=lf

# Windows-only scripts, if any are ever added, keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never diffed, never converted
*.webp binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.avif binary
*.ico binary
*.hdr binary
*.exr binary
*.ktx2 binary
*.glb binary
*.gltf -text
*.bin binary
*.pdf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
*.ogg binary
*.wasm binary
*.zip binary

# Generated / vendored: collapse in GitHub diffs
package-lock.json linguist-generated=true
