# Copy this file to .env.local (never commit .env.local) / Salin ke .env.local (jangan di-commit).
#
# Optional: shared walk-through ("explore together") over Supabase Realtime.
# Without these two the multiplayer menu still works between tabs of the same browser.
# Opsional: jelajah bareng lewat Supabase Realtime. Tanpa ini hanya antar-tab di browser yang sama.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional TURN server for voice chat over mobile data / Opsional untuk suara lewat data seluler
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_CREDENTIAL=

# Optional PIN gate on Vercel (set these in the Vercel project's Environment Variables, not here).
# When SITE_PIN is empty the site is public.
# Opsional: gerbang PIN di Vercel (atur di Environment Variables Vercel). Kosong = situs publik.
SITE_PIN=
SITE_SECRET=
