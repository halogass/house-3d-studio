{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm.cmd run *)",
      "Bash(node -v)",
      "Bash(node --version)",
      "Bash(npm -v)",
      "Bash(node scripts/*)",
      "Bash(npx vite *)",
      "Bash(npx playwright install chromium)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Read(./**)",
      "Edit(./projects/**)",
      "Edit(./docs/wizard/**)"
    ],
    "ask": [
      "Bash(npx vercel *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Edit(./engine/**)",
      "Edit(./studio/**)",
      "Edit(./scripts/**)",
      "Edit(./package.json)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.vercel/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(npm publish*)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}
